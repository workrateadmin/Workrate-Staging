modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = "pnpm verify:release-storage && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/workrate run build"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }


[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
HMRC_OAUTH_REDIRECT_URL = "https://work-rate-manager.replit.app/api/hmrc/callback"

[userenv.production]
PROPOSAL_BASE_URL = "https://work-rate-manager.replit.app"
WORKRATE_ENV = "production"
WORKRATE_STORAGE_ENV = "production"
WORKRATE_BUILD_ID = "84332c25b0aea7e32ace0330a85afc153bc9e60d"

[userenv.development]
WORKRATE_BUILD_ID = "local-development"
WORKRATE_ENV = "development"
WORKRATE_STORAGE_ENV = "development"
