modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/workrate run build"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }


[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
HMRC_OAUTH_REDIRECT_URL = "https://work-rate-manager.replit.app/api/hmrc/callback"

[userenv.production]
PROPOSAL_BASE_URL = "https://work-rate-manager.replit.app"
WORKRATE_ENV = "production"
WORKRATE_STORAGE_ENV = "production"
WORKRATE_BUILD_ID = "a8c1afb2b0f2f391e162ba53b7a71a314bffd7de"
WORKRATE_EXPECTED_STORAGE_BUCKET_FINGERPRINT = "e3a50e5234b4"

[userenv.development]
WORKRATE_BUILD_ID = "local-development"
WORKRATE_ENV = "development"
WORKRATE_STORAGE_ENV = "development"

[objectStorage]
defaultBucketID = "replit-objstore-fc3ca7d9-86c2-4ebd-841a-5791efa5879e"
