{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:hmrc-security": "node ./test/build-and-run-hmrc-security-tests.mjs",
    "test:hmrc-quarterly-preparation": "node ./test/build-and-run-hmrc-quarterly-preparation-tests.mjs",
    "test:hmrc-gateway-client": "node ./test/build-and-run-hmrc-gateway-client-tests.mjs",
    "test:finance-validation": "node ./test/build-and-run-finance-validation-tests.mjs",
    "test:invoice-pdf": "node ./test/build-and-run-invoice-pdf-tests.mjs",
    "test:vapi-security": "node ./test/build-and-run-vapi-security-tests.mjs",
    "test:integration-security": "node ./test/build-and-run-integration-security-tests.mjs",
    "test:billing": "node ./test/build-and-run-billing-tests.mjs",
    "test:timeline": "node ./test/build-and-run-timeline-tests.mjs",
    "test:job-cost-evidence": "node ./test/build-and-run-job-cost-evidence-tests.mjs",
    "test": "pnpm run test:billing",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.49",
    "@clerk/shared": "^4.25.10",
    "@google-cloud/storage": "^7.21.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@swc/helpers": "^0.5.23",
    "@types/multer": "^2.2.0",
    "@types/pdfkit": "^0.17.6",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "http-proxy-middleware": "^4.2.0",
    "multer": "^2.2.0",
    "openai": "^7.3.0",
    "pdfkit": "^0.20.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "xlsx": "^0.18.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/sharp": "^0.32.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
