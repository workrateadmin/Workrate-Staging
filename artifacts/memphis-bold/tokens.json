{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Memphis Bold design system tokens — extracted from the NestMatch neo-Memphis mockup. Vivid four-color palette on warm cream, zero border-radius, thick black borders, hard offset shadows. Edit values here only — never hand-edit src/index.css or src/generated/tokens.tsx.",
  "color": {
    "$type": "color",
    "light": {
      "background":          { "$value": "#FFF6E9", "$description": "Warm cream page background." },
      "foreground":          { "$value": "#000000" },
      "border":              { "$value": "#000000", "$description": "Thick black border — the Memphis signature." },
      "card":                { "$value": "#FFFFFF" },
      "cardForeground":      { "$value": "#000000" },
      "popover":             { "$value": "#FFFFFF" },
      "popoverForeground":   { "$value": "#000000" },
      "primary":             { "$value": "#FF4D8D", "$description": "Hot pink — primary CTAs, love/claim actions." },
      "primaryForeground":   { "$value": "#FFFFFF" },
      "secondary":           { "$value": "#2EC4B6", "$description": "Teal — secondary surfaces and badges." },
      "secondaryForeground": { "$value": "#000000" },
      "muted":               { "$value": "#F5EBD8", "$description": "Slightly toasted cream for muted surfaces." },
      "mutedForeground":     { "$value": "#7A6A55" },
      "accent":              { "$value": "#FFC700", "$description": "Golden yellow — highlights and hover states." },
      "accentForeground":    { "$value": "#000000" },
      "destructive":         { "$value": "#FF2D55" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input":               { "$value": "#000000" },
      "ring":                { "$value": "#FF4D8D" },
      "chart1":              { "$value": "#FF4D8D" },
      "chart2":              { "$value": "#2EC4B6" },
      "chart3":              { "$value": "#FFC700" },
      "chart4":              { "$value": "#3A36E0" },
      "chart5":              { "$value": "#FF6B35" },
      "sidebar":             { "$value": "#1A1208" },
      "sidebarForeground":   { "$value": "#FFF6E9" },
      "sidebarBorder":       { "$value": "#000000" },
      "sidebarPrimary":      { "$value": "#FF4D8D" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent":       { "$value": "#2EC4B6" },
      "sidebarAccentForeground": { "$value": "#000000" },
      "sidebarRing":         { "$value": "#FFC700" }
    },
    "dark": {
      "background":          { "$value": "#1A0F05", "$description": "Very dark warm brown." },
      "foreground":          { "$value": "#FFF6E9" },
      "border":              { "$value": "#000000" },
      "card":                { "$value": "#2A1A08" },
      "cardForeground":      { "$value": "#FFF6E9" },
      "popover":             { "$value": "#2A1A08" },
      "popoverForeground":   { "$value": "#FFF6E9" },
      "primary":             { "$value": "#FF4D8D" },
      "primaryForeground":   { "$value": "#FFFFFF" },
      "secondary":           { "$value": "#2EC4B6" },
      "secondaryForeground": { "$value": "#000000" },
      "muted":               { "$value": "#2A1A0A" },
      "mutedForeground":     { "$value": "#A08060" },
      "accent":              { "$value": "#FFC700" },
      "accentForeground":    { "$value": "#000000" },
      "destructive":         { "$value": "#FF2D55" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input":               { "$value": "#3A2A10" },
      "ring":                { "$value": "#FF4D8D" },
      "chart1":              { "$value": "#FF4D8D" },
      "chart2":              { "$value": "#2EC4B6" },
      "chart3":              { "$value": "#FFC700" },
      "chart4":              { "$value": "#3A36E0" },
      "chart5":              { "$value": "#FF6B35" },
      "sidebar":             { "$value": "#0F0805" },
      "sidebarForeground":   { "$value": "#FFF6E9" },
      "sidebarBorder":       { "$value": "#2A1A08" },
      "sidebarPrimary":      { "$value": "#FF4D8D" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent":       { "$value": "#2EC4B6" },
      "sidebarAccentForeground": { "$value": "#000000" },
      "sidebarRing":         { "$value": "#FFC700" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Space Grotesk", "sans-serif"], "$description": "UI and body face — legible grotesque with a technical edge." },
      "serif": { "$value": ["Archivo Black", "sans-serif"], "$description": "Display/headline face — ultra-bold slab used for all hero text and section titles." },
      "mono":  { "$value": ["JetBrains Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0rem", "$description": "Zero radius — Memphis is all hard geometric corners." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" }
  }
}
